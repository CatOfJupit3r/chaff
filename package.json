{
  "name": "chaff",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter=web --filter=desktop --filter=@chaff/common --filter=@chaff/server-contract run dev",
    "build": "pnpm --recursive run build",
    "package": "pnpm run build && pnpm --filter=desktop run package",
    "install-app": "tsx scripts/install-app.ts",
    "test": "pnpm --recursive --stream run test",
    "check-types": "pnpm --recursive --stream --no-bail run check-types",
    "prettify": "pnpm --recursive --stream run prettify",
    "prettier": "pnpm run prettify",
    "dev:web": "pnpm --filter=web run dev",
    "dev:common": "pnpm --filter=@chaff/common run dev",
    "dev:server-contract": "pnpm --filter=@chaff/server-contract run dev",
    "db:generate": "pnpm --filter=@chaff/core run db:generate",
    "lint": "pnpm --recursive --stream --no-bail run lint",
    "lint:fix": "pnpm run lint",
    "verify": "tsx scripts/verify.ts",
    "clean:modules": "tsx scripts/clean.ts",
    "prepare": "husky",
    "commit": "cz",
    "build:deps": "pnpm --filter=@chaff/server-contract... run build",
    "update:workspaces": "pnpm update --interactive --recursive"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "commitizen": "4.3.2",
    "cz-git": "1.13.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "rimraf": "6.1.3",
    "tsx": "catalog:"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git",
      "czConfig": "./cz.config.cjs"
    }
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": "24.13.0",
    "pnpm": ">=11.5.0"
  }
}
