# After a pull on main, rebuilds and reinstalls Chaff in the background once `git config chaff.autoInstall true` is set (install-app asks).
[ "$(uname)" = "Darwin" ] || exit 0
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0
[ "$(git config --bool chaff.autoInstall)" = "true" ] || exit 0
mkdir -p "$HOME/Library/Logs/Chaff"
nohup pnpm run install-app >> "$HOME/Library/Logs/Chaff/install-app.log" 2>&1 &
echo "Chaff: rebuilding the installed app in the background (log: ~/Library/Logs/Chaff/install-app.log)"
