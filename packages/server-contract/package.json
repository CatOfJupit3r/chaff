{
  "name": "@chaff/server-contract",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./app.contract": {
      "types": "./dist/app.contract.d.mts",
      "default": "./dist/app.contract.mjs"
    },
    "./contract/*": {
      "types": "./dist/contract/*.d.mts",
      "default": "./dist/contract/*.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch --no-clean",
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --fix",
    "prettify": "prettier --write ./src/",
    "test": "echo 'No tests for server contract library yet'",
    "prepare": "tsdown"
  },
  "prettier": "@chaff/prettier-config",
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@chaff/eslint-config": "workspace:*",
    "@chaff/prettier-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "@orpc/contract": "catalog:",
    "@chaff/common": "workspace:*",
    "enumwaii": "1.2.0",
    "zod": "catalog:"
  }
}
