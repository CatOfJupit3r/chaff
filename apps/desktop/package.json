{
  "name": "desktop",
  "productName": "Chaff",
  "version": "0.1.0",
  "private": true,
  "description": "Chaff, a stack-aware review workspace for AI-written changes",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsdown",
    "start": "electron .",
    "package": "electron-builder --config electron-builder.config.mjs",
    "check-types": "tsgo --noEmit",
    "lint": "eslint . --fix",
    "prettify": "prettier --write ./src/ ./scripts/",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "prettier": "@chaff/prettier-config",
  "devDependencies": {
    "@chaff/common": "workspace:*",
    "@chaff/core": "workspace:*",
    "@chaff/eslint-config": "workspace:*",
    "@chaff/prettier-config": "workspace:*",
    "@orpc/server": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "web": "workspace:*"
  }
}
